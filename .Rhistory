library(shiny); library(DT)
callback <- JS(
"table.on('column-reorder', function(e, settings, details){",
"  Shiny.setInputValue('columnsOrder', details);",
"});"
)
shinyApp(
ui = fluidPage(
p('Table 1'), fluidRow(column(12, DTOutput('table'))), p('Table 2'),  fluidRow(column(12, DTOutput('table1')))
),
server = function(input, output) {
output$table <- renderDT(
datatable(iris, extensions=c('ColReorder', 'Scroller'),
callback = callback, options=list(pageLength=5, colReorder=TRUE))
)
columnsOrder <- reactiveVal(seq_along(iris))
observeEvent(input$columnsOrder, {
fr <- input$columnsOrder[['from']]; to <- input$columnsOrder[['to']]
ord <- columnsOrder(); fr1 <- ord[fr]; to1 <- ord[to]; ord[to] <- fr1; ord[fr] <- to1
if (!is.null(input$columnsOrder)) columnsOrder(ord)
})
output$table1 <- renderDT(iris[1:3, columnsOrder()])
}
)
