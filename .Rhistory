uiOutput("goButton_ui"),
plotOutput("distPlot")
)
server <- function(input, output) {
output$distPlot <- renderPlot({
input$goButton
dist <- isolate(rnorm(input$obs))
hist(dist)
})
output$goButton_ui <- renderUI({
print(iris)
rclipButton("goButton", label= "Go!", clipText = format_csv(iris))
})
}
shinyApp(ui, server)
