),
server = function(input, output) {
output$table <- renderDT(
datatable(iris, extensions=c('ColReorder', 'Scroller'),  callback = callback, options=list(pageLength=5, colReorder=TRUE))
)
output$table1 <- renderDT(iris[1:3, input$columnsOrder])
}
)
